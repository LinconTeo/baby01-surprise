}, {"name": "Coca Cola 1.5 Liters", "price": 80, "category": "Carbohydrates Drink"}, {"name": "Coke Kasalo", "price": 38, "category": "Carbohydrates Drink"}, {"name": "Pancit Canton", "price": 18, "category": "Noodles"}, {"name": "Lucky Me Noodles", "price": 13, "category": "Noodles"}, {"name": "Lucky Me Labuyo", "price": 14, "category": "Noodles"}, {"name": "Nissin Ramen Seafood", "price": 18, "category": "Noodles"}, {"name": "Nissin CupNoodles", "price": 30, "category": "Noodles"}, {"name": "Marlboro", "price": 11, "category": "Cigarettes"}, {"name": "Camel", "price": 10, "category": "Cigarettes"}, {"name": "Fortune", "price": 10, "category": "Cigarettes"}, {"name": "Mighty", "price": 10, "category": "Cigarettes"}, {"name": "Winston", "price": 12, "category": "Cigarettes"}, {"name": "Chesterfield", "price": 9, "category": "Cigarettes"}, {"name": "Concord", "price": 7, "category": "Cigarettes"}, {"name": "Combi", "price": 8, "category": "Tinapay"}, {"name": "Bingo", "price": 8, "category": "Tinapay"}, {"name": "Lava Cake", "price": 11, "category": "Tinapay"}, {"name": "Fudgee Bar", "price": 11, "category": "Tinapay"}, {"name": "Cookies Bites", "price": 10, "category": "Tinapay"}, {"name": "Bravo", "price": 8, "category": "Tinapay"}, {"name": "Rebisco Strawberry", "price": 8, "category": "Tinapay"}, {"name": "Cheese Cake", "price": 11, "category": "Tinapay"}, {"name": "Cream O", "price": 9, "category": "Tinapay"}, {"name": "Magic Flakes Cheese", "price": 8, "category": "Tinapay"}, {"name": "Hiro", "price": 8, "category": "Tinapay"}, {"name": "Skyflakes", "price": 8, "category": "Tinapay"}, {"name": "Richeese Wafer", "price": 9, "category": "Tinapay"}, {"name": "Mani", "price": 5, "category": "Mani"}, {"name": "Super Crunch Chip Charon", "price": 15, "category": "Mani"}, {"name": "Vcut", "price": 20, "category": "Mani"}, {"name": "Piattos", "price": 20, "category": "Mani"}, {"name": "Nova", "price": 20, "category": "Mani"}, {"name": "Cheese Rings", "price": 10, "category": "Mani"}, {"name": "Clover", "price": 10, "category": "Mani"}, {"name": "Moby", "price": 10, "category": "Mani"}, {"name": "Loaded", "price": 10, "category": "Mani"}];
let activeCategory = "All";
let cart = [];
let savedReceipts = JSON.parse(localStorage.getItem("lincon_practice_saved_receipts_v3") || "[]");
const categories = ["All", ...new Set(items.map(i => i.category))];

function peso(n) {
  return Number(n).toLocaleString('en-PH');
}

function esc(text) {
  return String(text).replace(/'/g, "\\'");
}

function renderChips() {
  document.getElementById("chips").innerHTML = categories.map(cat => `
    <button class="chip ${activeCategory===cat?'active':''}" onclick="setCategory('${esc(cat)}')">${cat}</button>
  `).join("");
}

function filteredItems() {
  const q = document.getElementById("search").value.toLowerCase().trim();
  return items.filter(i => {
    const matchCategory = activeCategory === "All" || i.category === activeCategory;
    const matchSearch = i.name.toLowerCase().includes(q) || i.category.toLowerCase().includes(q);
    return matchCategory && matchSearch;
  });
}

function renderList() {
  const list = filteredItems();
  document.getElementById("list").innerHTML = list.length ? list.map(i => `
    <div class="item">
      <div>
        <div class="item-name">${i.name}</div>
        <div class="item-cat">${i.category}</div>
      </div>
      <div class="right">
        <div class="price">₱${peso(i.price)}</div>
        <button class="add" onclick="addItem('${esc(i.name)}')">Add</button>
      </div>
    </div>
  `).join("") : `<div class="empty">No items found.</div>`;
}

function addItem(name) {
  const item = items.find(i => i.name === name);
  const existing = cart.find(c => c.name === name);
  if (existing) existing.qty += 1;
  else cart.push({...item, qty: 1});
  updateCart();
}

function buildReceiptText(data, status, sino="", pinautang="") {
  const total = data.reduce((sum, i) => sum + i.price * i.qty, 0);
  const qty = data.reduce((sum, i) => sum + i.qty, 0);
  const lines = [];
  lines.push("lincon practice system");
  lines.push("Status: " + status.toUpperCase());
  if (status === "utang") {
    lines.push("Sino Umutang: " + sino);
    lines.push("Pinautang Ni: " + pinautang);
  }
  lines.push("Date: " + new Date().toLocaleString());
  lines.push("----------------------------");
  data.forEach(i => lines.push(`${i.name} x${i.qty} = ₱${peso(i.price * i.qty)}`));
  lines.push("----------------------------");
  lines.push("Total Qty: " + qty);
  lines.push("Grand Total: ₱" + peso(total));
  return lines.join("\n");
}

function generateReceiptImage(text) {
  const lines = text.split("\n");
  const canvas = document.createElement("canvas");
  const ctx = canvas.getContext("2d");
  const width = 700;
  const lineHeight = 34;
  const padding = 30;
  canvas.width = width;
  canvas.height = padding * 2 + lines.length * lineHeight + 20;

  ctx.fillStyle = "#ffffff";
  ctx.fillRect(0, 0, canvas.width, canvas.height);

  ctx.fillStyle = "#2563eb";
  ctx.fillRect(0, 0, canvas.width, 70);

  ctx.fillStyle = "#ffffff";
  ctx.font = "bold 28px Arial";
  ctx.fillText("lincon practice system", 24, 42);

  ctx.fillStyle = "#0f172a";
  ctx.font = "22px Arial";
  let y = 100;
  lines.forEach(line => {
    ctx.fillText(line, 24, y);
    y += lineHeight;
  });

  return canvas.toDataURL("image/png");
}

function saveReceipt(status) {
  if (!cart.length) {
    alert("Receipt is empty.");
    return;
  }

  const sino = document.getElementById("sinoUtang").value.trim();
  const pinautang = document.getElementById("pinautang").value.trim();

  if (status === "utang" && (!sino || !pinautang)) {
    alert("Lagyan muna ng Sino Umutang at Pinautang Ni.");
    return;
  }

  const text = buildReceiptText(cart, status, sino, pinautang);
  const image = generateReceiptImage(text);

  const entry = {
    id: Date.now(),
    status,
    sino,
    pinautang,
    total: cart.reduce((sum, i) => sum + i.price * i.qty, 0),
    qty: cart.reduce((sum, i) => sum + i.qty, 0),
    text,
    image
  };

  savedReceipts.unshift(entry);
  localStorage.setItem("lincon_practice_saved_receipts_v3", JSON.stringify(savedReceipts));
  renderSavedReceipts();
  alert(status === "utang" ? "Utang receipt saved." : "Completed receipt saved.");
  cart = [];
  updateCart();
}

function renderSavedReceipts() {
  const box = document.getElementById("savedReceipts");
  box.innerHTML = savedReceipts.length ? savedReceipts.map(r => `
    <div class="saved-item">
      <div class="saved-title">${r.status === 'utang' ? 'Utang' : 'Completed'} • ₱${peso(r.total)}</div>
      <div class="saved-sub">${r.text}</div>
      <img class="thumb" src="${r.image}" alt="Receipt image">
      <div class="saved-actions">
        <button class="preview" onclick="previewImage(${r.id})">View Image</button>
        <a class="download" href="${r.image}" download="receipt-${r.id}.png">Download Image</a>
        <button class="delete" onclick="deleteSaved(${r.id})">Delete</button>
      </div>
    </div>
  `).join("") : `<div class="empty">No saved receipts yet.</div>`;
}

function previewImage(id) {
  const found = savedReceipts.find(r => r.id === id);
  if (!found) return;
  document.getElementById("previewImg").src = found.image;
  document.getElementById("imageModal").classList.add("show");
}

function closeImagePreview() {
  document.getElementById("imageModal").classList.remove("show");
}

function deleteSaved(id) {
  savedReceipts = savedReceipts.filter(r => r.id !== id);
  localStorage.setItem("lincon_practice_saved_receipts_v3", JSON.stringify(savedReceipts));
  renderSavedReceipts();
}

function updateCart() {
  const total = cart.reduce((sum, i) => sum + i.price * i.qty, 0);
  const qty = cart.reduce((sum, i) => sum + i.qty, 0);
  document.getElementById("total").innerText = peso(total);
  document.getElementById("qtyLabel").innerText = qty + " qty";
  document.getElementById("countLabel").innerText = filteredItems().length + " items";
  document.getElementById("cartItemsLabel").innerText = cart.length + " items in receipt";

  document.getElementById("cartList").innerHTML = cart.length ? cart.map((i, idx) => `
    <div class="cart-item">
      <div>
        <div class="cart-name">${i.name}</div>
        <div class="cart-sub">${i.category} • ₱${peso(i.price)} each</div>
      </div>
      <div style="text-align:right">
        <div class="qty">
          <button onclick="changeQty(${idx}, -1)">-</button>
          <span>${i.qty}</span>
          <button onclick="changeQty(${idx}, 1)">+</button>
        </div>
        <div style="margin-top:6px;font-weight:700">₱${peso(i.price * i.qty)}</div>
      </div>
    </div>
  `).join("") : `<div class="empty">Receipt is empty.</div>`;
}

function changeQty(idx, delta) {
  cart[idx].qty += delta;
  if (cart[idx].qty <= 0) cart.splice(idx, 1);
  updateCart();
}

function setCategory(cat) {
  activeCategory = cat;
  renderChips();
  renderList();
  updateCart();
}

function clearCart() {
  cart = [];
  updateCart();
}

function openCart() {
  document.getElementById("modal").classList.add("show");
  renderSavedReceipts();
}

function closeCart() {
  document.getElementById("modal").classList.remove("show");
}

document.getElementById("search").addEventListener("input", () => {
  renderList();
  updateCart();
});

document.getElementById("modal").addEventListener("click", (e) => {
  if (e.target.id === "modal") closeCart();
});
document.getElementById("imageModal").addEventListener("click", (e) => {
  if (e.target.id === "imageModal") closeImagePreview();
});

renderChips();
renderList();
updateCart();
renderSavedReceipts();
</script>
</body>
</html>
