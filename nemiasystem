<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>lincon practice system</title>
<style>
*{box-sizing:border-box;font-family:Arial,sans-serif}
body{margin:0;background:#eef5ff;color:#0f172a}
.top{position:sticky;top:0;z-index:10;background:#2563eb;color:white;padding:10px 10px 8px;box-shadow:0 4px 14px rgba(0,0,0,.12)}
.title{font-weight:700;font-size:18px}
.search{width:100%;padding:12px 14px;border:none;border-radius:12px;margin-top:8px;font-size:15px}
.summary{display:flex;justify-content:space-between;gap:10px;margin-top:8px;font-size:13px;opacity:.95}
.chips{display:flex;gap:8px;overflow:auto;padding:10px 10px 0;background:#eef5ff;position:sticky;top:86px;z-index:9}
.chips::-webkit-scrollbar{display:none}
.chip{white-space:nowrap;border:none;background:white;border-radius:999px;padding:9px 12px;font-size:13px;color:#2563eb}
.chip.active{background:#2563eb;color:white}
.container{padding:10px 10px 110px}
.item{background:white;margin-bottom:10px;padding:12px;border-radius:14px;display:flex;justify-content:space-between;align-items:center;gap:10px;box-shadow:0 4px 10px rgba(37,99,235,.08)}
.item-name{font-size:14px;font-weight:600}
.item-cat{font-size:11px;color:#64748b;margin-top:3px}
.right{display:flex;align-items:center;gap:8px;flex-shrink:0}
.price{font-weight:700;color:#2563eb;font-size:14px}
button.add{padding:9px 12px;border:none;border-radius:10px;background:#2563eb;color:white;font-weight:700}
.empty{text-align:center;color:#64748b;padding:30px 10px}
.cart{position:fixed;bottom:0;left:0;right:0;background:white;border-top:2px solid #2563eb;padding:10px;box-shadow:0 -6px 20px rgba(0,0,0,.08)}
.cart-top{display:flex;justify-content:space-between;align-items:center;gap:10px}
.total{font-size:18px;font-weight:700;color:#2563eb}
.actions{display:flex;gap:8px;margin-top:8px}
.actions button{flex:1;padding:10px;border:none;border-radius:10px;font-weight:700}
.view{background:#2563eb;color:white}
.clear{background:#e2e8f0;color:#0f172a}
.utang{background:#f59e0b;color:white}
.save{background:#16a34a;color:white}
.modal{position:fixed;inset:0;background:rgba(15,23,42,.45);display:none;align-items:flex-end;z-index:20}
.modal.show{display:flex}
.sheet{background:white;width:100%;max-height:85vh;border-radius:18px 18px 0 0;padding:14px;overflow:auto}
.sheet h3{margin:0 0 10px}
.cart-item{display:flex;justify-content:space-between;gap:8px;padding:10px 0;border-bottom:1px solid #e2e8f0}
.cart-name{font-size:14px;font-weight:600}
.cart-sub{font-size:12px;color:#64748b;margin-top:2px}
.qty{display:flex;align-items:center;gap:6px}
.qty button{width:28px;height:28px;border:none;border-radius:8px;background:#dbeafe;color:#1d4ed8;font-weight:700}
.close{margin-top:10px;width:100%;padding:11px;border:none;border-radius:10px;background:#2563eb;color:white;font-weight:700}
.saved-box{margin-top:14px;padding-top:10px;border-top:1px solid #e2e8f0}
.saved-item{background:#f8fbff;border:1px solid #dbeafe;border-radius:12px;padding:10px;margin-bottom:10px}
.saved-title{font-size:13px;font-weight:700}
.saved-sub{font-size:12px;color:#64748b;margin-top:4px;white-space:pre-wrap}
.name{width:100%;padding:10px 12px;margin:8px 0;border:1px solid #cbd5e1;border-radius:10px}
.saved-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
.saved-actions button,.saved-actions a{padding:8px 10px;border:none;border-radius:8px;font-size:12px;font-weight:700;text-decoration:none;display:inline-block}
.preview{background:#2563eb;color:white}
.download{background:#0f766e;color:white}
.delete{background:#dc2626;color:white}
.thumb{width:100%;max-width:180px;border-radius:10px;border:1px solid #dbeafe;margin-top:8px}
</style>
</head>
<body>
<div class="top">
  <div class="title">lincon practice system</div>
  <input id="search" class="search" placeholder="Search item...">
  <div class="summary">
    <span id="countLabel">0 items</span>
    <span id="qtyLabel">0 qty</span>
  </div>
</div>

<div class="chips" id="chips"></div>
<div class="container" id="list"></div>

<div class="cart">
  <div class="cart-top">
    <div>
      <div style="font-size:12px;color:#64748b">Total</div>
      <div class="total">₱<span id="total">0</span></div>
    </div>
    <div style="font-size:12px;color:#64748b;text-align:right">
      <div id="cartItemsLabel">0 items in receipt</div>
    </div>
  </div>
  <div class="actions">
    <button class="view" onclick="openCart()">View Receipt</button>
    <button class="clear" onclick="clearCart()">Clear</button>
  </div>
</div>

<div class="modal" id="modal">
  <div class="sheet">
    <h3>Receipt</h3>
    <div id="cartList"></div>

    <input class="name" id="sinoUtang" placeholder="Sino Umutang:">
    <input class="name" id="pinautang" placeholder="Pinautang Ni:">

    <div class="actions">
      <button class="save" onclick="saveReceipt('completed')">Save Receipt Completed</button>
      <button class="utang" onclick="saveReceipt('utang')">Save Receipt Utang</button>
    </div>

    <div class="saved-box">
      <h3 style="margin-top:14px">Saved Receipts</h3>
      <div id="savedReceipts"></div>
    </div>

    <button class="close" onclick="closeCart()">Close</button>
  </div>
</div>

<div class="modal" id="imageModal">
  <div class="sheet" style="max-height:90vh">
    <h3>Receipt Image Preview</h3>
    <img id="previewImg" style="width:100%;border-radius:12px;border:1px solid #dbeafe" alt="Receipt preview">
    <button class="close" onclick="closeImagePreview()">Close</button>
  </div>
</div>

